{
  "name": "hunter-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-aware HUNTER x HUNTER fan community with a 2.5D saloon interface.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.14 || ^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "architecture:check": "depcruise --config dependency-cruiser.config.mjs src",
    "config:check": "tsx scripts/check-config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "quality": "pnpm config:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm test && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "dotenv": "17.2.3",
    "next": "16.2.12",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dependency-cruiser": "18.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
