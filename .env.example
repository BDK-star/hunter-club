# Runtime classification
APP_ENV=local
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# Use the pooled runtime URL for Vercel/serverless traffic.
DATABASE_URL=postgresql://hunter_club:hunter_club@localhost:5432/hunter_club

# Use a direct or session connection for migrations and administrative tasks.
DATABASE_MIGRATION_URL=postgresql://hunter_club:hunter_club@localhost:5432/hunter_club

# Optional as a pair. Public reading remains available when Auth is disabled.
# Find both values in Supabase Dashboard > Project Settings > API / Connect.
# NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Optional 32+ character HMAC key. Enables anonymous search metrics without
# storing query text. Keep it server-only and rotate under an explicit policy.
# SEARCH_METRIC_FINGERPRINT_KEY=replace-with-at-least-32-random-characters

# Later phases will add storage, mail and monitoring variables.
